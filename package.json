{
  "name": "deadend-round2-mvp",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run build && node --check server.js && node --check engine.js && node --check public/app.js && npm test",
    "build": "esbuild src/scene3d.js --bundle --minify --format=iife --platform=browser --target=es2020 --outfile=public/scene3d.bundle.js",
    "prestart": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "three": "0.180.0"
  }
}
